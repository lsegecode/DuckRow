# =============================================================================
# DuckRow Service Desk - Backend Environment Configuration (.env)
# =============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True

# Allowed Hosts & Security
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://duckrow.lucassanabria.com,https://api.duckrow.lucassanabria.com,http://localhost:5173,http://localhost:80
CORS_ALLOWED_ORIGINS=https://duckrow.lucassanabria.com,http://localhost:5173,http://localhost:80

# Frontend Application URL (Used for CORS, SSO redirects, and Teams notification links)
FRONTEND_URL=https://duckrow.lucassanabria.com

# Database Configuration
# 1. Primary Cloud Option (Neon.tech Serverless PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/duckrow?sslmode=require

# 2. Local Engine Option (if DATABASE_URL is not set): sqlite | postgres | mssql
DB_ENGINE=sqlite

# If DB_ENGINE=postgres (Docker or local Postgres):
# DB_NAME=duckrow
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# If DB_ENGINE=mssql (Microsoft SQL Server):
# DB_NAME=DuckRowDB
# DB_USER=duckrow_user
# DB_PASSWORD=YourSecurePasswordHere!
# DB_HOST=localhost
# DB_PORT=1433
# DB_SCHEMA=dbo
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes;

# Single Sign-On (SSO) Integration Settings
HOME_WEB_SSO_SALT=duckrow-sso-auth
# HOME_WEB_SSO_SECRET_KEY=your-dedicated-sso-signing-secret

# Microsoft Teams / Power Automate Webhooks (Optional)
# Leave empty to disable automated Teams alerts
TEAMS_WEBHOOK_URL=
TEAMS_WEBHOOK_CTES_URL=
