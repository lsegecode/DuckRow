# =============================================================================
# DuckRow Service Desk - Backend Environment Configuration (.env)
# =============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True

# Frontend Application URL (Used for CORS, SSO redirects, and Teams notification links)
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Options for DB_ENGINE: sqlite | mssql
DB_ENGINE=sqlite

# If DB_ENGINE=mssql (Optional - Microsoft SQL Server connection)
# DB_NAME=DuckRowDB
# DB_USER=duckrow_user
# DB_PASSWORD=YourSecurePasswordHere!
# DB_HOST=localhost
# DB_PORT=1433
# DB_SCHEMA=dbo
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes;

# Single Sign-On (SSO) Integration Settings
HOME_WEB_SSO_SALT=duckrow-sso-auth
# HOME_WEB_SSO_SECRET_KEY=your-dedicated-sso-signing-secret

# Microsoft Teams / Power Automate Webhooks (Optional)
# Leave empty to disable automated Teams alerts
TEAMS_WEBHOOK_URL=
TEAMS_WEBHOOK_CTES_URL=
